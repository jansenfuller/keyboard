 *
 * Lily58 keymap — 4-layer layout, 5-column footprint (outer cols &trans).
 * Mac-oriented: GUI = CMD, ALT = Opt.
 * Home-row mods: D=Ctrl, F=Shift, J=Shift, K=Ctrl
 * Combos: D+F = ESC
 */

#include <dt-bindings/zmk/behaviors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "HRM Left";
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "HRM Right";
        };
    };

    combos {
        compatible = "zmk,combos";
        esc_combo {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp ESC>;
        };
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ==================================================================
        //  Layer 0 — Letters  (QWERTY + home-row mods)
        //  Outer columns &trans (outside 5-col footprint)
        // ==================================================================
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   Q   │   W   │   E   │   R   │   T   │ │   Y   │   U   │   I   │   O   │   P   │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │ A/CMD │ S/Opt │D/Ctrl │F/Shft │   G   │ │   H   │J/Shft │K/Ctrl │ L/Opt │;/CMD  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   Z   │   X   │   C   │   V   │   B   │ │   N   │   M   │   ,   │   .   │   /   │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │ MO(1) │  TAB  │ BSPC  │         │ SPACE │  ENT  │ MO(2) │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘
        default_layer {
            display-name = "Letters";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp Q   &kp W   &kp E   &kp R   &kp T                       &kp Y   &kp U   &kp I   &kp O   &kp P   &trans
&trans      &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G      &kp H   &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &trans
&trans      &kp Z   &kp X   &kp C   &kp V   &kp B   &trans  &trans      &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &trans
                            &trans  &mo 1   &kp TAB &kp BSPC             &kp SPACE &kp RET &mo 2   &trans
            >;
        };

        // ==================================================================
        //  Layer 1 — Numbers & Symbols  (left thumb MO(1) held)
        //  Same-side thumbs transparent
        // ==================================================================
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   #   │   '   │   "   │   @   │   ?   │ │   =   │   7   │   8   │   9   │   +   │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   [   │   (   │   ]   │   )   │   _   │ │   *   │   4   │   5   │   6   │   /   │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   <   │   {   │   >   │   }   │   \   │ │   0   │   1   │   2   │   3   │   $   │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │ TRNS  │ TRNS  │ TRNS  │         │ TRNS  │ TRNS  │ MO(3) │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘
        num_sym_layer {
            display-name = "Num & Sym";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp HASH &kp SQT &kp DQT  &kp AT   &kp QMARK                &kp EQUAL &kp N7 &kp N8 &kp N9 &kp PLUS  &trans
&trans      &kp LBKT &kp LPAR &kp RBKT &kp RPAR &kp UNDER               &kp ASTRK &kp N4 &kp N5 &kp N6 &kp FSLH &trans
&trans      &kp LT   &kp LBRC &kp GT   &kp RBRC &kp BSLH &trans &trans  &kp N0    &kp N1 &kp N2 &kp N3 &kp DOLLAR &trans
                            &trans  &trans  &trans  &trans              &trans  &trans  &mo 3   &trans
            >;
        };

        // ==================================================================
        //  Layer 2 — Arrows + Overflow Symbols  (right thumb MO(2) held)
        //  Same-side thumbs transparent
        // ==================================================================
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   ~   │   ^   │   &   │ TRNS  │ TRNS  │ │ HOME  │ PGDN  │ PGUP  │  END  │  DEL  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   !   │   -   │   `   │   %   │   |   │ │ LEFT  │ DOWN  │  UP   │ RIGHT │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │ MO(3) │ TRNS  │ TRNS  │         │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘
        arr_nav_layer {
            display-name = "Arrows & Nav";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp TILDE &kp CARET &kp AMPS &trans  &trans                 &kp HOME &kp PGDN &kp PGUP &kp END &kp DEL  &trans
&trans      &kp EXCL &kp MINUS &kp GRAVE &kp PERCENT &kp PIPE           &kp LEFT &kp DOWN &kp UP  &kp RIGHT &trans &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans &trans   &trans  &trans
                            &trans  &mo 3   &trans  &trans              &trans   &trans   &trans &trans
            >;
        };

        // ==================================================================
        //  Layer 3 — F-keys + System  (both thumbs held)
        // ==================================================================
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │  F1   │  F2   │  F3   │  F4   │  F5   │ │  F6   │  F7   │  F8   │  F9   │  F10  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │  F11  │  F12  │ TRNS  │  RST  │ BOOT  │ │  BT0  │  BT1  │  BT2  │  BT3  │ BTCLR │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │ TRNS  │ TRNS  │ TRNS  │         │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘
        sys_layer {
            display-name = "System";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                     &kp F6   &kp F7  &kp F8  &kp F9  &kp F10 &trans
&trans      &kp F11 &kp F12 &trans  &sys_reset &bootloader              &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans &trans   &trans  &trans
                            &trans  &trans  &trans  &trans              &trans   &trans   &trans &trans
            >;
        };
    };
};
