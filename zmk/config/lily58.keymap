/*
 * Lily58 keymap — 4-layer, 5-col footprint. Mac: GUI=CMD, Alt=Opt.
 * Home-row mods: D=Ctrl F=Shift J=Shift K=Ctrl.  Combo: D+F=ESC
 * Paired by key: `/~  -/_  /?  '/"  \/|  =/+
 */

#include <dt-bindings/zmk/behaviors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hml: homerow_mod_left { compatible="zmk,behavior-hold-tap"; #binding-cells=<2>; flavor="balanced"; tapping-term-ms=<200>; require-prior-idle-ms=<150>; bindings=<&kp>,<&kp>; };
        hmr: homerow_mod_right { compatible="zmk,behavior-hold-tap"; #binding-cells=<2>; flavor="balanced"; tapping-term-ms=<200>; require-prior-idle-ms=<150>; bindings=<&kp>,<&kp>; };
    };
    combos { compatible="zmk,combos"; esc_combo { timeout-ms=<50>; key-positions=<53 54>; bindings=<&kp ESC>; }; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &kp Q  &kp W  &kp E  &kp R  &kp T                   &kp Y  &kp U  &kp I  &kp O  &kp P  &trans
&trans &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G  &kp H &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &trans
&trans &kp Z  &kp X  &kp C  &kp V  &kp B  &trans &trans   &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &trans
                        &trans &mo 1  &kp TAB &kp BSPC     &kp SPACE &kp RET &mo 2   &trans
            >;
        };

        // L1 — Lower symbols + numpad (left thumb)
        num_sym_layer {
            bindings = <
&trans &trans  &trans  &trans  &trans  &trans              &trans  &trans &trans &trans &trans &trans
&trans &kp DOT   &kp FSLH &kp MINUS &kp BSLH &trans        &kp EQUAL &kp N7 &kp N8 &kp N9 &kp GRAVE &trans
&trans &kp LBKT &kp LPAR &kp RBKT &kp RPAR &trans          &kp ASTRK &kp N4 &kp N5 &kp N6 &kp SQT &trans
&trans &kp LT   &kp LBRC &kp GT   &kp RBRC &trans &trans &trans &kp N0 &kp N1 &kp N2 &kp N3 &kp PLUS &trans
                        &trans &trans  &trans &trans         &trans &trans &mo 3   &trans
            >;
        };

        // L2 — Upper symbols + arrows at hjkl (right thumb)
        arr_nav_layer {
            bindings = <
&trans &trans  &trans  &trans  &trans  &trans              &trans  &trans &trans &trans &trans &trans
&trans &kp TILDE &kp EXCL &kp UNDER &kp PIPE &kp CARET      &trans &trans &trans &trans &trans &trans
&trans &kp PERCENT &kp AT &kp HASH &kp DOLLAR &kp AMPS      &kp LEFT &kp DOWN &kp UP  &kp RIGHT &kp DQT &trans
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans &trans &trans &trans &trans &trans &trans
                        &trans &mo 3   &trans &trans         &trans &trans &trans &trans
            >;
        };

        // L3 — Nav + F-keys + system (both thumbs)
        sys_layer {
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &kp F1  &kp F2 &kp F3 &kp F4 &kp F5                 &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &trans
&trans &kp F11 &kp F12 &trans &sys_reset &bootloader       &kp HOME &kp PGDN &kp PGUP &kp END &kp DEL &trans
&trans &trans &trans &trans &trans &trans &trans &trans    &bt BT_CLR &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans         &trans &trans &trans &trans
            >;
        };
    };
};
