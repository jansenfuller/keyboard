 *
 * Lily58 keymap constrained to a 6-column Corne footprint.
 * Rows 1–3 + inner 3 thumbs per half are active; row 0 + outer thumbs are &trans.
 * Mac-oriented: GUI = CMD, ALT = Opt.
 */

#include <dt-bindings/zmk/behaviors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <125>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
    };

    // ------------------------------------------------------------------
    //  nice!view display — auto-configured by the nice_view shield.
    //  Default status screen shows BLE, battery, output, and layer.
    // ------------------------------------------------------------------

    keymap {
        compatible = "zmk,keymap";

        // ==================================================================
        //  Layer 0 — Letters  (QWERTY + home-row mods)
        // ==================================================================
        //  Corne-overlap keys are active; top row + outer thumbs = &trans.
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  TAB  │   Q   │   W   │   E   │   R   │   T   │ │   Y   │   U   │   I   │   O   │   P   │ BSPC  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  ESC  │ A/CMD │ S/Opt │D/Ctrl │F/Shft │   G   │ │   H   │J/Shft │K/Ctrl │ L/Opt │;/CMD  │   "   │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ SHFT  │   Z   │   X   │   C   │   V   │   B   │ │   N   │   M   │   ,   │   .   │   /   │ SHFT  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │  LWR  │  TAB  │ BSPC  │         │  SPC  │  ENT  │  RSE  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘

        default_layer {
            display-name = "Letters";
            bindings = <
&trans         &trans   &trans   &trans    &trans    &trans   &trans      &trans     &trans   &trans    &trans     &trans   &trans   &trans
&kp TAB        &kp Q    &kp W    &kp E     &kp R     &kp T                          &kp Y    &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp ESC        &mt LGUI A &mt LALT S &mt LCTRL D &mt LSHFT F &kp G                  &kp H    &mt RSHFT J &mt RCTRL K &mt RALT L &mt RGUI SEMI &kp LS(SQT)
&kp LSHFT      &kp Z    &kp X    &kp C     &kp V     &kp B                          &kp N    &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                               &trans    &mo 1    &kp TAB  &kp BSPC    &kp SPACE  &kp RET  &mo 2    &trans
            >;
        };

        // ==================================================================
        //  Layer 1 — Numerals & Symbols
        // ==================================================================
        //  3×3 numblock (7-8-9 / 4-5-6 / 1-2-3) on the right,
        //  shifted one column inward, with 0 flanking both sides
        //  of the bottom row.  Left side carries programming symbols.
        //  Paired brackets on ring & pointer columns; pinky columns
        //  reserved for low-frequency singletons.
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │   !   │   #   │   ^   │   &   │   *   │   ?   │ │   =   │   7   │   8   │   9   │   +   │   -   │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │   `   │   [   │   (   │   ]   │   )   │   ~   │ │   *   │   4   │   5   │   6   │   /   │   \   │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │   \   │   <   │   {   │   >   │   }   │   |   │ │   0   │   1   │   2   │   3   │   0   │   `   │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │ TRNS  │   _   │   '   │         │   :   │   .   │ TRNS  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘

        num_sym_layer {
            display-name = "Num & Sym";
            bindings = <
&trans         &trans   &trans   &trans    &trans    &trans   &trans      &trans     &trans   &trans    &trans     &trans   &trans   &trans
&kp LS(N1)   &kp LS(N3) &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(FSLH)               &kp EQUAL &kp N7    &kp N8     &kp N9   &kp LS(EQUAL) &kp MINUS
&kp GRAVE    &kp LBKT &kp LS(N9) &kp RBKT  &kp LS(N0) &kp LS(GRAVE)               &kp LS(N8) &kp N4    &kp N5     &kp N6   &kp FSLH  &kp BSLH
&kp BSLH     &kp LS(COMMA) &kp LS(LBKT) &kp LS(DOT) &kp LS(RBKT) &kp LS(BSLH)    &kp N0    &kp N1    &kp N2     &kp N3   &kp N0    &kp GRAVE
                               &trans    &trans    &kp LS(MINUS) &kp SQT   &kp LS(SEMI) &kp DOT &trans    &trans
            >;
        };

        // ==================================================================
        //  Layer 2 — Functional
        // ==================================================================
        //  F-keys, navigation cluster, Bluetooth profiles, firmware ops.
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  F1   │  F2   │  F3   │  F4   │  F5   │  F6   │ │ HOME  │ PGDN  │ PGUP  │  END  │  INS  │  DEL  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  F7   │  F8   │  F9   │  F10  │  F11  │  F12  │ │ LEFT  │ DOWN  │  UP   │ RIGHT │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ BTCLR │ BT0   │ BT1   │ BT2   │ BT3   │ BT4   │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ BOOT  │ TRNS  │ TRNS  │  RST  │         │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘

        func_layer {
            display-name = "Functional";
            bindings = <
&trans         &trans   &trans   &trans    &trans    &trans   &trans      &trans     &trans    &trans    &trans     &trans   &trans    &trans
&kp F1         &kp F2   &kp F3   &kp F4    &kp F5    &kp F6                        &kp HOME  &kp PGDN  &kp PGUP   &kp END   &kp INS   &kp DEL
&kp F7         &kp F8   &kp F9   &kp F10   &kp F11   &kp F12                       &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT &trans    &trans
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &trans    &trans    &trans     &trans   &trans    &trans
                               &bootloader &trans  &trans  &sys_reset   &trans    &trans    &trans    &trans
            >;
        };
    };
};
