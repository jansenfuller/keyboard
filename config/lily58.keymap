 *
 * Lily58 keymap constrained to a 6-column Corne footprint.
 * Rows 1–3 + inner 3 thumbs per half are active; row 0 + outer thumbs are &trans.
 * Mac-oriented: GUI = CMD, ALT = Opt.
 */

#include <dt-bindings/zmk/behaviors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Home-row mods — any key press on either side activates the hold.
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "HRM Left";
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "HRM Right";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ==================================================================
        //  Layer 0 — Letters  (QWERTY + home-row mods)
        // ==================================================================
        //
        //  Row 0 — all &trans (outside Corne footprint)
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   Q   │   W   │   E   │   R   │   T   │ │   Y   │   U   │   I   │   O   │   P   │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  ESC  │ A/CMD │ S/Opt │D/Ctrl │F/Shft │   G   │ │   H   │J/Shft │K/Ctrl │ L/Opt │;/CMD  │   '   │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │   Z   │   X   │   C   │   V   │   B   │ │   N   │   M   │   ,   │   .   │   /   │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ SHFT  │  LWR  │  TAB  │ BSPC  │         │  SPC  │  ENT  │  RSE  │ SHFT  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘

        default_layer {
            display-name = "Letters";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp Q   &kp W   &kp E   &kp R   &kp T                       &kp Y   &kp U   &kp I   &kp O   &kp P   &trans
&kp ESC     &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G      &kp H   &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&trans      &kp Z   &kp X   &kp C   &kp V   &kp B   &trans  &trans      &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &trans
                            &kp LSHFT &mo 1   &kp TAB &kp BSPC             &kp SPACE &kp RET &mo 2   &kp RSHFT
            >;
        };

        // ==================================================================
        //  Layer 1 — Numerals & Symbols
        // ==================================================================
        //
        //  Row 0 — all &trans
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │   !   │   #   │   ^   │   &   │   *   │   ?   │ │   =   │   7   │   8   │   9   │   +   │   -   │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │   `   │   [   │   (   │   ]   │   )   │   ~   │ │   @   │   4   │   5   │   6   │   /   │   \   │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │   %   │   <   │   {   │   >   │   }   │   |   │ │   0   │   1   │   2   │   3   │   $   │ ESC  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ TRNS  │ TRNS  │   _   │   '   │         │   :   │   .   │ TRNS  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘

        num_sym_layer {
            display-name = "Num & Sym";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&kp EXCL   &kp HASH &kp CARET &kp AMPS &kp ASTRK &kp QMARK               &kp EQUAL &kp N7 &kp N8 &kp N9 &kp PLUS  &kp MINUS
&kp GRAVE  &kp LBKT &kp LPAR &kp RBKT &kp RPAR  &kp TILDE                &kp AT    &kp N4 &kp N5 &kp N6 &kp FSLH &kp BSLH
&kp PERCENT &kp LT &kp LBRC &kp GT   &kp RBRC  &kp PIPE &trans &trans    &kp N0    &kp N1 &kp N2 &kp N3 &kp DOLLAR &kp ESC
                            &trans  &trans  &kp UNDER &kp SQT              &kp COLON &kp DOT &trans &trans
            >;
        };

        // ==================================================================
        //  Layer 2 — Functional
        // ==================================================================
        //
        //  Row 0 — all &trans
        //
        //  ┌───────┬───────┬───────┬───────┬───────┬───────┐ ┌───────┬───────┬───────┬───────┬───────┬───────┐
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  F1   │  F2   │  F3   │  F4   │  F5   │  F6   │ │ HOME  │ PGDN  │ PGUP  │  END  │  INS  │  DEL  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │  F7   │  F8   │  F9   │  F10  │  F11  │  F12  │ │ LEFT  │ DOWN  │  UP   │ RIGHT │ TRNS  │ TRNS  │
        //  ├───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┤
        //  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //  └───────┴───────┴───────┴───────┴───────┴───────┘ └───────┴───────┴───────┴───────┴───────┴───────┘
        //            ┌───────┬───────┬───────┬───────┐         ┌───────┬───────┬───────┬───────┐
        //            │ BOOT  │ TRNS  │ TRNS  │  RST  │         │ TRNS  │ TRNS  │ TRNS  │ TRNS  │
        //            └───────┴───────┴───────┴───────┘         └───────┴───────┴───────┴───────┘

        func_layer {
            display-name = "Functional";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&kp F1      &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                     &kp HOME &kp PGDN &kp PGUP &kp END &kp INS &kp DEL
&kp F7      &kp F8  &kp F9  &kp F10 &kp F11 &kp F12                    &kp LEFT &kp DOWN &kp UP  &kp RIGHT &trans &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans &trans   &trans  &trans
                            &bootloader &trans &trans &sys_reset         &trans   &trans   &trans &trans
            >;
        };
    };
};
